{
  "id": "digikam",
  "name": "digiKam",
  "summary": "Photo manager and raw developer",
  "category": "photo",
  "homepage": "https://www.digikam.org/",
  "license": "GPL-2.0",
  "windows": {
    "winget": ["KDE.digiKam"],
    "choco": ["digikam"],
    "scoop": ["extras/digikam"],
    "registry": ["digiKam"],
    "paths": {
      "config": "%APPDATA%/digikamrc",
      "data": "%LOCALAPPDATA%/digikam"
    }
  },
  "linux": {
    "pacman": ["digikam"],
    "apt": ["digikam"],
    "dnf": ["digikam"],
    "zypper": ["digikam"],
    "apk": ["digikam"],
    "flatpak": ["org.kde.digikam"],
    "paths": {
      "config": "$XDG_CONFIG_HOME/digikamrc",
      "data": "$XDG_DATA_HOME/digikam"
    }
  },
  "config": {
    "portability": "translatable",
    "exclude": ["thumbnails-digikam.db", "*.db-journal", "*.db-wal", "*.log"],
    "notes": "digikamrc points at the collection root and the database folder by absolute path, so it is kept aside. The albums database is usually stored with the photographs rather than here; the thumbnail database is a cache and is rebuilt."
  },
  "equivalents": ["shotwell", "darktable", "rawtherapee"]
}
