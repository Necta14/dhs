  "summary": "Lightweight spreadsheet",
  "category": "office",
  "homepage": "https://www.gnumeric.org/",
  "license": "GPL-2.0",
  "linux": {
    "pacman": ["gnumeric"],
    "apt": ["gnumeric"],
