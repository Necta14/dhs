      "lapce"
    ],
    "scoop": [
      "extras/lapce"
    ],
    "registry": [
      "Lapce"
    ]
  },
  "linux": {
    "pacman": [
      "lapce"
    ],
    "zypper": [
      "lapce"
    ],
    "apk": [
      "lapce"
    ],
