{
  "id": "maxima",
  "name": "Maxima",
  "summary": "Computer algebra system",
  "category": "science",
  "homepage": "https://maxima.sourceforge.io/",
  "license": "GPL-2.0",
  "windows": {
    "winget": ["MaximaTeam.Maxima"],
    "choco": ["maxima"],
    "scoop": ["extras/maxima"],
    "registry": ["Maxima"]
  },
  "linux": {
    "pacman": ["maxima"],
    "apt": ["maxima"],
    "dnf": ["maxima"],
    "zypper": ["maxima"],
    "paths": {
      "config": "~/.maxima"
    }
