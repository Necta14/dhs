{
  "id": "gnome-boxes",
  "name": "GNOME Boxes",
  "summary": "Simple virtual machine manager for GNOME",
  "category": "virtualization",
  "homepage": "https://apps.gnome.org/Boxes/",
  "license": "LGPL-2.1",
  "linux": {
    "pacman": [
      "gnome-boxes"
    ],
    "apt": [
      "gnome-boxes"
    ],
    "dnf": [
      "gnome-boxes"
    ],
    "zypper": [
      "gnome-boxes"
    ],
    "apk": [
      "gnome-boxes"
    ],
    "flatpak": [
      "org.gnome.Boxes"
    ]
  },
  "config": {
    "portability": "none",
