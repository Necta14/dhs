pkgbase = dhs
	pkgver = 0.1.1
	pkgrel = 1
	url = https://dhs-suite.vercel.app
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	makedepends = go
	options = !debug
	source = dhs-0.1.1.tar.gz::https://github.com/Necta14/dhs/releases/download/v0.1.1/dhs-0.1.1-source.tar.gz
	sha256sums = SKIP

pkgname = dhs-cli
	pkgdesc = Migrate a working environment between operating systems through a portable, encrypted package
	provides = dhs

pkgname = dhs-gui
	pkgdesc = GTK4 front end for DHS, the migration tool between operating systems
	arch = any
	depends = dhs-cli
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
