# Maintainer: Necta <179446771+Necta14@users.noreply.github.com>
# A split package: one recipe, two packages. dhs-cli is the tool itself; dhs-gui is the optional
# GTK4 front end, a separate process that drives the CLI over --json (decision D9).
pkgbase=dhs
pkgname=('dhs-cli' 'dhs-gui')
pkgver=0.1.2
pkgrel=1
arch=('x86_64' 'aarch64')
url="https://dhs-suite.vercel.app"
license=('Apache-2.0')
makedepends=('go')
# The binary is linked with -s -w, so there is nothing for makepkg's debug package to hold and
# gdb-add-index complains about the missing symbols. Go binaries are conventionally built this way.
options=('!debug')
source=("$pkgbase-$pkgver.tar.gz::https://github.com/Necta14/dhs/releases/download/v$pkgver/dhs-$pkgver-source.tar.gz")
sha256sums=('41987c8a19fcf09001ac5dc02bdae7d2f7ac4edf797121a7552aa9e4bec53cd6')

prepare() {
  cd "$pkgbase-$pkgver"
  go mod download
}

build() {
  cd "$pkgbase-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  # -buildmode=pie for the hardening Arch expects. Go links PIE internally when CGO is off, so
  # the binary stays static and keeps the property the project is built around: nothing to
  # install on the destination system. The release artifacts are plain static binaries.
  go build -buildmode=pie -ldflags "-s -w -X main.version=$pkgver" -o dhs ./cmd/dhs
}

check() {
  cd "$pkgbase-$pkgver"
  go test ./...
}

package_dhs-cli() {
  pkgdesc="Migrate a working environment between operating systems through a portable, encrypted package"
  provides=('dhs')
  cd "$pkgbase-$pkgver"
  install -Dm755 dhs "$pkgdir/usr/bin/dhs"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/dhs-cli/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/dhs-cli/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/dhs-cli/README.md"
  install -Dm644 README.ro.md "$pkgdir/usr/share/doc/dhs-cli/README.ro.md"
}

package_dhs-gui() {
  pkgdesc="GTK4 front end for DHS, the migration tool between operating systems"
  arch=('any')
  depends=('dhs-cli' 'python' 'python-gobject' 'glib2' 'gtk4' 'libadwaita' 'hicolor-icon-theme')
  cd "$pkgbase-$pkgver"
  # The script carries its own shebang and finds the binary on PATH, so it needs no wrapper.
  install -Dm755 gui/linux/dhs-gui.py "$pkgdir/usr/bin/dhs-gui"
  install -Dm644 gui/linux/io.github.necta14.dhs.desktop \
    "$pkgdir/usr/share/applications/io.github.necta14.dhs.desktop"
  install -Dm644 assets/dhs.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.necta14.dhs.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/dhs-gui/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/dhs-gui/NOTICE"
}
