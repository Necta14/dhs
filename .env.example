# Copiază în .env.local și completează. .env.local e ignorat de git.

# Cheia Google AI Studio (aistudio.google.com/apikey). Fără ea, dhs merge doar în mod lexical.
GEMINI_API_KEY=

# Opțional — baza SQLite. Implicit: ~/.local/share/dhs/dhs.sqlite (memoria globală, comună proiectelor).
# În dezvoltare, ține-o în repo, ca să nu murdărești memoria reală:
# DHS_DB_PATH=data/dhs.sqlite

# Opțional — modelul și dimensiunea vectorilor. Implicit: gemini-embedding-2 la 768.
# DHS_EMBED_MODEL=gemini-embedding-2
# DHS_EMBED_DIMS=768

# Opțional — plafoanele limitatorului, sub free tier. Implicit: 90 / 28000.
# DHS_EMBED_RPM=90
# DHS_EMBED_TPM=28000
